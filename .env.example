# 环境变量配置示例
# 复制此文件为 .env 并填入你的 API Keys

# ========== 必需配置 ==========

# Tikhub API Key（用于下载抖音视频）
TIKHUB_API_KEY=your_tikhub_api_key_here

# OpenAI API Key（用于 Whisper 转写和 GPT-4 写作）
OPENAI_API_KEY=sk-your_openai_api_key_here

# 微信公众号 AppID
WECHAT_APPID=wx_your_appid_here

# 微信公众号 AppSecret
WECHAT_APPSECRET=your_appsecret_here

# ========== 可选配置 ==========

# Unsplash API Key（用于自动配图）
UNSPLASH_ACCESS_KEY=your_unsplash_key_here

# 默认输出目录
OUTPUT_DIR=output

# 默认写作风格 (pm 或 tech)
DEFAULT_STYLE=pm

# 默认主题 (科技蓝, 活力橙, 高雅灰, 清新绿)
DEFAULT_THEME=科技蓝

# ========== 多账号配置 ==========

# 第二个公众号账号
WECHAT_APPID_ACCOUNT2=wx_second_appid
WECHAT_APPSECRET_ACCOUNT2=second_appsecret

# ========== 转写引擎配置 ==========

# 转写引擎 (whisper.cpp / funasr / paddlespeech / openai)
# 推荐：whisper.cpp（免费且质量高）
WHISPER_ENGINE=whisper.cpp

# Whisper.cpp 模型 (tiny / base / small / medium / large)
# 推荐：base（速度快）或 small（质量高）
WHISPER_MODEL=base

# OpenAI Whisper 模型（仅当 WHISPER_ENGINE=openai 时需要）
OPENAI_WHISPER_MODEL=whisper-1

# ========== 高级配置 ==========

# GPT 模型 (gpt-4 或 gpt-4-turbo)
GPT_MODEL=gpt-4

# 最大重试次数
MAX_RETRIES=3

# 请求超时（秒）
REQUEST_TIMEOUT=30
